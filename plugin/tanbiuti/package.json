{
  "name": "tanbiuti",
  "version": "0.1.0",
  "private": true,
  "description": "Tanbiuti plugin — dev tooling (wp-env for integration tests, wp-scripts for the mobile-first front-end build).",
  "scripts": {
    "wp-env": "wp-env",
    "env:start": "wp-env start",
    "env:destroy": "wp-env destroy",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/tanbiuti -- vendor/bin/phpunit -c phpunit.xml.dist",
    "build": "wp-scripts build --webpack-src-dir=assets/src --output-path=assets/build",
    "start": "wp-scripts start --webpack-src-dir=assets/src --output-path=assets/build",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style"
  },
  "devDependencies": {
    "@wordpress/env": "^11.15.0",
    "@wordpress/scripts": "^35.0.0",
    "typescript": "^5.6.2"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "core-js@3.50.0": true,
    "core-js-pure@3.50.0": true,
    "fs-ext-extra-prebuilt@2.2.7": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
