{
  "name": "@tanbiuti/extractor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Extrai o histórico de um painel de gestão de salão (agenda, comandas, clientes) via login autenticado + chamadas diretas à API.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --check src",
    "test": "vitest run"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "p-limit": "^6.1.0",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
