{
  "name": "@tanbiuti/fake-data-generator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gera um dataset sintético (faker, seed fixa) com o mesmo shape dos dados reais extraídos, e monta o WXR versionado usado pelo blueprint do Playground.",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --check src",
    "test": "vitest run"
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/node": "^22.7.4",
    "eslint": "^9.11.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
